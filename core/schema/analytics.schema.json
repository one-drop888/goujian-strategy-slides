{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics.schema.json",
  "title": "Validated analytical recipe input",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe",
        "title",
        "source",
        "synthetic",
        "period",
        "primary_metric",
        "metrics",
        "trend",
        "contributions"
      ],
      "properties": {
        "recipe": {
          "const": "business-performance"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "primary_metric": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "unit",
              "actual",
              "target",
              "previous_month",
              "previous_year"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "actual": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "target": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "previous_month": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "previous_year": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "trend": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "month",
              "actual"
            ],
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "actual": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "actual",
              "previous"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "actual": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "previous": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe",
        "title",
        "source",
        "synthetic",
        "period",
        "as_of",
        "horizon_days",
        "stages",
        "outcome_stage",
        "edges",
        "leads",
        "events"
      ],
      "properties": {
        "recipe": {
          "const": "sales-conversion"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "outcome_stage": {
          "type": "string",
          "minLength": 1
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "leads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lead_id",
              "customer_id",
              "acquired",
              "channel",
              "region"
            ],
            "properties": {
              "lead_id": {
                "type": "string",
                "minLength": 1
              },
              "customer_id": {
                "type": "string",
                "minLength": 1
              },
              "acquired": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "customer_id",
              "stage",
              "date"
            ],
            "properties": {
              "customer_id": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe",
        "title",
        "source",
        "synthetic",
        "period",
        "as_of",
        "unit",
        "projects",
        "milestones",
        "currency",
        "measurement_basis"
      ],
      "properties": {
        "recipe": {
          "const": "project-analytics"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "planned_units",
              "actual_units",
              "planned_days",
              "actual_days",
              "day_rate",
              "budget",
              "external_cost",
              "realized_value",
              "risk"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "planned_units": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "actual_units": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "planned_days": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "actual_days": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "day_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "budget": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "external_cost": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "realized_value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "risk": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "unknown"
                ]
              }
            }
          }
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "project_id",
              "name",
              "planned",
              "actual"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "planned": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "actual": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "currency": {
          "const": "CNY"
        },
        "measurement_basis": {
          "const": "cumulative_as_of"
        }
      }
    }
  ]
}
