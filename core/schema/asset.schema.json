{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset.schema.json",
  "type": "object",
  "required": ["id", "path", "type", "role", "source"],
  "$defs": {
    "region": {
      "type": "object", "required": ["x", "y", "w", "h"], "additionalProperties": false,
      "properties": {"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}}
    },
    "provenance": {
      "type":"object", "required":["kind","render_mode"],
      "properties": {
        "kind":{"enum":["native_text","image_text","ocr","generated_annotation","source_data","derived_insight"]},
        "source_asset":{"type":"string"}, "source_region":{"$ref":"#/$defs/region"},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "render_mode":{"enum":["editable","embedded","reference_only"]}, "text":{"type":"string"}
      },
      "allOf":[{"if":{"properties":{"kind":{"enum":["image_text","ocr"]}}},"then":{"required":["source_asset","source_region","confidence"]}}]
    }
  },
  "properties": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9_-]+$"},
    "path":{"type":"string","minLength":1,"pattern":"^(?![a-zA-Z]+://).+"},
    "type":{"enum":["photography","product_image","document_screenshot","ui_screenshot","chart_screenshot","table_screenshot","diagram","background","decorative_asset"]},
    "role":{"enum":["evidence","hero","background","decoration"]},
    "source":{"type":"string","minLength":1}, "mime":{"type":"string"},
    "width":{"type":"number","exclusiveMinimum":0}, "height":{"type":"number","exclusiveMinimum":0},"aspect_ratio":{"type":"number","exclusiveMinimum":0},
    "focal_point":{"type":"object","required":["x","y"],"properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}}},
    "crop":{"$ref":"#/$defs/region"}, "safe_area":{"$ref":"#/$defs/region"},
    "fit":{"enum":["contain","cover","crop"]}, "opacity":{"type":"number","minimum":0,"maximum":1},
    "mask":{"enum":["rect","ellipse","rounded"]}, "allow_crop":{"type":"boolean"},
    "caption":{"type":"string"}, "attribution":{"type":"string"},
    "provenance":{"type":"array","items":{"$ref":"#/$defs/provenance"}}
  },
  "additionalProperties": false
}
