{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck.schema.json",
  "title": "Goujian Strategy Slides Deck",
  "type": "object",
  "required": [
    "title",
    "slides"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "storyline": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "footer": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "slide.schema.json"
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "latin": {
          "type": "string",
          "minLength": 1
        },
        "cjk": {
          "type": "string",
          "minLength": 1
        },
        "title_size": {
          "type": "number",
          "minimum": 18,
          "maximum": 44
        },
        "body_size": {
          "type": "number",
          "minimum": 12,
          "maximum": 28
        },
        "preferred": {
          "type": "object",
          "properties": {
            "latin": {
              "type": "string"
            },
            "cjk": {
              "type": "string"
            }
          }
        },
        "fallback_latin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback_cjk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "accent_soft": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "panel": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "line": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "margin_x": {
          "type": "number",
          "minimum": 0.45,
          "maximum": 1.1
        },
        "title_rule": {
          "enum": [
            "line",
            "accent",
            "none"
          ]
        },
        "table_header": {
          "enum": [
            "soft",
            "solid"
          ]
        },
        "table_banding": {
          "type": "boolean"
        },
        "metric_style": {
          "enum": [
            "open",
            "panel"
          ]
        },
        "chart_grid": {
          "enum": [
            "light",
            "none"
          ]
        },
        "cover_treatment": {
          "enum": [
            "editorial",
            "band"
          ]
        },
        "table_size": {
          "type": "number",
          "minimum": 12,
          "maximum": 20
        },
        "chart_size": {
          "type": "number",
          "minimum": 10,
          "maximum": 18
        },
        "image_gap": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.7
        },
        "image_caption_size": {
          "type": "number",
          "minimum": 10,
          "maximum": 14
        },
        "image_border": {
          "enum": [
            "line",
            "none"
          ]
        }
      }
    },
    "background": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "asset.schema.json"
      }
    }
  },
  "additionalProperties": true
}
