{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck.schema.json",
  "title": "Goujian Strategy Slides Deck",
  "type": "object",
  "required": [
    "title",
    "slides"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "storyline": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "footer": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "slide.schema.json"
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "latin": {
          "type": "string",
          "minLength": 1
        },
        "cjk": {
          "type": "string",
          "minLength": 1
        },
        "title_size": {
          "type": "number",
          "minimum": 18,
          "maximum": 44
        },
        "body_size": {
          "type": "number",
          "minimum": 12,
          "maximum": 28
        },
        "preferred": {
          "type": "object",
          "properties": {
            "latin": {
              "type": "string"
            },
            "cjk": {
              "type": "string"
            }
          }
        },
        "fallback_latin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback_cjk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "accent_soft": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "panel": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "line": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "margin_x": {
          "type": "number",
          "minimum": 0.45,
          "maximum": 1.1
        },
        "title_rule": {
          "enum": [
            "line",
            "accent",
            "none"
          ]
        },
        "table_header": {
          "enum": [
            "soft",
            "solid"
          ]
        },
        "table_banding": {
          "type": "boolean"
        },
        "metric_style": {
          "enum": [
            "open",
            "panel"
          ]
        },
        "chart_grid": {
          "enum": [
            "light",
            "none"
          ]
        },
        "cover_treatment": {
          "enum": [
            "editorial",
            "band"
          ]
        },
        "table_size": {
          "type": "number",
          "minimum": 12,
          "maximum": 20
        },
        "chart_size": {
          "type": "number",
          "minimum": 10,
          "maximum": 18
        },
        "image_gap": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.7
        },
        "image_caption_size": {
          "type": "number",
          "minimum": 10,
          "maximum": 14
        },
        "image_border": {
          "enum": [
            "line",
            "none"
          ]
        }
      }
    },
    "background": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "asset.schema.json"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "metric.schema.json"
      }
    },
    "series_registry": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "narrative": {
      "type": "object",
      "description": "Agent-authored argument structure; checks declared output presence and references, not source truth or aesthetics.",
      "required": [
        "objective",
        "nodes",
        "evidence",
        "claims"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "slide",
              "role",
              "question",
              "claim_ids",
              "evidence_ids"
            ],
            "properties": {
              "slide": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "enum": [
                  "cover",
                  "transition",
                  "summary",
                  "detail",
                  "comparison",
                  "decision",
                  "appendix"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "maxItems": 500
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "maxItems": 500
              },
              "decision_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "maxItems": 500
              },
              "expansion_note": {
                "type": "string",
                "minLength": 1
              },
              "transition": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "claims": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "FACT",
                  "CALCULATION",
                  "INTERPRETATION",
                  "HYPOTHESIS",
                  "RECOMMENDATION"
                ]
              },
              "type": {
                "enum": [
                  "FACT",
                  "CALCULATION",
                  "INTERPRETATION",
                  "HYPOTHESIS",
                  "RECOMMENDATION"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "maxItems": 500
              },
              "required": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "id",
              "bindings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "bindings": {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "required": [
                    "slide",
                    "pointer"
                  ],
                  "properties": {
                    "slide": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pointer": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "relation",
              "explanation"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "to": {
                "type": "integer",
                "minimum": 1
              },
              "relation": {
                "enum": [
                  "introduces",
                  "supports",
                  "expands",
                  "contrasts",
                  "leads_to",
                  "recaps"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "claim_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "maxItems": 500
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "timing": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
