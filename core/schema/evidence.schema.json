{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "metric",
        "quote",
        "fact",
        "source",
        "assumption"
      ]
    },
    "value": {},
    "unit": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
