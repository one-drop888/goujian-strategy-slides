{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slide.schema.json",
  "title": "Semantic Slide",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "action",
        "action-plan",
        "agenda",
        "architecture",
        "area",
        "audience-strategy",
        "bar",
        "baseline",
        "before-after",
        "benchmark",
        "big-number",
        "bridge",
        "bubble",
        "business-case",
        "capability-model",
        "case-study",
        "chart",
        "checklist",
        "closing",
        "cohort",
        "column",
        "combo",
        "comparison",
        "competitive-landscape",
        "cost-structure",
        "cover",
        "customer-journey",
        "decision",
        "decomposition",
        "distribution",
        "document-evidence",
        "driver-tree",
        "evidence-quote",
        "executive-summary",
        "feature-matrix",
        "fishbone",
        "framework",
        "funnel",
        "heatmap",
        "histogram",
        "image-background",
        "image-comparison",
        "image-evidence",
        "image-gallery",
        "image-grid",
        "image-hero",
        "image-insight",
        "image-text-split",
        "issue",
        "key-message",
        "kpi",
        "kpi-dashboard",
        "line",
        "map",
        "matrix",
        "milestone",
        "mitigation-plan",
        "option-assessment",
        "organization",
        "portfolio",
        "priority",
        "process",
        "product-positioning",
        "pyramid",
        "quadrant",
        "recommendation",
        "regional-performance",
        "relationship-map",
        "research-method",
        "resource-plan",
        "risk",
        "roadmap",
        "roadmap-kpi",
        "root-cause",
        "sales-funnel",
        "sankey-flow",
        "scatter",
        "scenario-analysis",
        "scorecard",
        "section",
        "segmentation",
        "statement",
        "strategy-map",
        "table",
        "target-operating-model",
        "timeline",
        "trend",
        "variance",
        "waterfall",
        "win-loss"
      ]
    },
    "title": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "takeaway": {
      "type": "string"
    },
    "composition": {
      "type": "string"
    },
    "source": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "unit": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "items": {
      "type": "array"
    },
    "columns": {
      "type": "array"
    },
    "rows": {
      "type": "array"
    },
    "headers": {
      "type": "array"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "values"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "labels": {
      "type": "array"
    },
    "statement": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "insight": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "chartType": {
      "type": "string",
      "enum": [
        "bar",
        "column",
        "line",
        "area",
        "pie",
        "doughnut"
      ]
    },
    "highlightIndex": {
      "type": "integer",
      "minimum": 0
    },
    "axisMin": {
      "type": "number"
    },
    "subtitle": {
      "type": "string"
    },
    "title_short": {
      "type": "string",
      "minLength": 1
    },
    "analytical_series": {
      "type": "object",
      "required": [
        "id",
        "metrics",
        "task"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "task": {
          "type": "string"
        }
      }
    },
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "parent_of",
              "belongs_to",
              "supports",
              "annotates",
              "caption_of",
              "background_of",
              "source_of"
            ]
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "image",
              "chart",
              "table"
            ]
          },
          "role": {
            "enum": [
              "evidence",
              "annotation",
              "takeaway",
              "source"
            ]
          },
          "asset_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "provenance": {
            "$ref": "asset.schema.json#/$defs/provenance"
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_region"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_region": {
            "$ref": "asset.schema.json#/$defs/region"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "required": [
        "unit",
        "labels",
        "series"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "values"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "decision_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "note"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
