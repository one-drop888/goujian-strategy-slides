{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slide.schema.json",
  "title": "Semantic Slide",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "action",
        "action-plan",
        "agenda",
        "architecture",
        "area",
        "audience-strategy",
        "bar",
        "baseline",
        "before-after",
        "benchmark",
        "big-number",
        "bridge",
        "bubble",
        "business-case",
        "capability-model",
        "case-study",
        "chart",
        "checklist",
        "closing",
        "cohort",
        "column",
        "combo",
        "comparison",
        "competitive-landscape",
        "cost-structure",
        "cover",
        "customer-journey",
        "decision",
        "decomposition",
        "distribution",
        "document-evidence",
        "driver-tree",
        "evidence-quote",
        "executive-summary",
        "feature-matrix",
        "fishbone",
        "framework",
        "funnel",
        "heatmap",
        "histogram",
        "image-background",
        "image-comparison",
        "image-evidence",
        "image-gallery",
        "image-grid",
        "image-hero",
        "image-insight",
        "image-text-split",
        "issue",
        "key-message",
        "kpi",
        "kpi-dashboard",
        "line",
        "map",
        "matrix",
        "milestone",
        "mitigation-plan",
        "option-assessment",
        "organization",
        "portfolio",
        "priority",
        "process",
        "product-positioning",
        "pyramid",
        "quadrant",
        "recommendation",
        "regional-performance",
        "relationship-map",
        "research-method",
        "resource-plan",
        "risk",
        "roadmap",
        "roadmap-kpi",
        "root-cause",
        "sales-funnel",
        "sankey-flow",
        "scatter",
        "scenario-analysis",
        "scorecard",
        "section",
        "segmentation",
        "statement",
        "strategy-map",
        "table",
        "target-operating-model",
        "timeline",
        "trend",
        "variance",
        "waterfall",
        "win-loss"
      ]
    },
    "title": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "takeaway": {
      "type": "string"
    },
    "composition": {
      "type": "string"
    },
    "source": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "unit": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "items": {
      "type": "array"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "label": {"type": "string"},
          "lane": {"type": "integer"},
          "kind": {"enum": ["task", "decision", "milestone"]},
          "owner": {"type": "string"},
          "date": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    },
    "stage_labels": {
      "type": "array",
      "items": {"type": "string"}
    },
    "lane_labels": {
      "type": "array",
      "items": {"type": "string"}
    },
    "columns": {
      "type": "array"
    },
    "rows": {
      "type": "array"
    },
    "headers": {
      "type": "array"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "actual",
              "target",
              "history",
              "forecast",
              "comparison",
              "benchmark"
            ]
          },
          "metric_id": {
            "type": "string"
          },
          "metric_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "storage_scale": {
            "enum": [
              "fraction",
              "percent",
              "unit",
              "thousand",
              "million",
              "billion"
            ]
          },
          "display_unit": {
            "type": "string"
          },
          "stack": {
            "type": "boolean"
          },
          "emphasis": {
            "type": "boolean"
          },
          "style": {
            "type": "object",
            "properties": {
              "dash": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "marker_size": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]{6}$"
              }
            },
            "additionalProperties": false
          },
          "labels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": ["number", "null"]
            }
          }
        },
        "anyOf": [
          {"required": ["values"]},
          {"required": ["metric_id"]},
          {"required": ["metric_ids"]}
        ]
      }
    },
    "labels": {
      "type": "array"
    },
    "statement": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "insight": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "chartType": {
      "type": "string",
      "enum": [
        "bar",
        "column",
        "line",
        "area",
        "pie",
        "doughnut"
      ]
    },
    "highlightIndex": {
      "type": "integer",
      "minimum": 0
    },
    "axisMin": {
      "type": "number"
    },
    "subtitle": {
      "type": "string"
    },
    "title_short": {
      "type": "string",
      "minLength": 1
    },
    "analytical_series": {
      "type": "object",
      "required": [
        "id",
        "metrics",
        "task"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "task": {
          "type": "string"
        }
      }
    },
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "parent_of",
              "belongs_to",
              "supports",
              "annotates",
              "caption_of",
              "background_of",
              "source_of"
            ]
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "image",
              "chart",
              "table"
            ]
          },
          "role": {
            "enum": [
              "evidence",
              "annotation",
              "takeaway",
              "source"
            ]
          },
          "asset_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "provenance": {
            "$ref": "asset.schema.json#/$defs/provenance"
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_region"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_region": {
            "$ref": "asset.schema.json#/$defs/region"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "required": [
        "unit",
        "labels",
        "series"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "id": {"type": "string"},
              "metric_id": {"type": "string"},
              "metric_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "storage_scale": {"enum": ["fraction","percent","unit","thousand","million","billion"]},
              "display_unit": {"type": "string"},
              "role": {"enum": ["actual","target","history","forecast","comparison","benchmark"]},
              "values": {
                "type": "array",
                "items": {
                  "type": ["number", "null"]
                }
              }
            },
            "anyOf": [
              {"required": ["values"]},
              {"required": ["metric_id"]},
              {"required": ["metric_ids"]}
            ]
          }
        },
        "numberFormat": {"type": "string"}
      }
    },
    "decision_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "note"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "metric_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_id",
          "pointer"
        ],
        "additionalProperties": false,
        "properties": {
          "metric_id": {"type": "string"},
          "pointer": {"type": "string", "pattern": "^/"},
          "precision": {"type": "integer", "minimum": 0, "maximum": 6},
          "replace": {"type": "boolean"}
        }
      }
    },
    "metric_precision": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 6}
    },
    "missing_policy": {
      "enum": ["gap", "null", "reject"]
    },
    "numberFormat": {"type": "string"},
    "histogram": {"type": "boolean"},
    "axis_note": {"type": "string"},
    "stack_group": {"type": "string"},
    "bins": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["start", "end", "count"],
        "additionalProperties": false,
        "properties": {
          "start": {"type": "number"},
          "end": {"type": "number"},
          "count": {"type": "number", "minimum": 0}
        }
      }
    },
    "visual_encoding": {
      "type": "object",
      "properties": {
        "relation": {"enum": ["comparison", "trend", "composition", "distribution", "relationship"]},
        "palette_type": {"enum": ["categorical", "sequential", "diverging", "semantic"]},
        "domain": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {"min": {"type": "number"}, "max": {"type": "number"}}
        },
        "center": {"type": "number"},
        "label_strategy": {"enum": ["auto", "none", "value", "category", "category_value", "percent"]},
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "role": {"enum": ["actual", "target", "history", "forecast", "comparison", "benchmark"]},
              "emphasis": {"type": "boolean"}
            }
          }
        },
        "semantic": {
          "type": "object",
          "required": ["positive", "negative", "neutral", "higher_is_better"],
          "properties": {
            "positive": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "negative": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "neutral": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "higher_is_better": {"type": "boolean"}
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
