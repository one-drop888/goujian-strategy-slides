{
  "name": "goujian-strategy-slides",
  "version": "1.3.1",
  "private": false,
  "description": "Goujian Strategy Slides — production-grade Presentation Intelligence for AI agents",
  "license": "Apache-2.0",
  "scripts": {
    "validate:example": "python3 skill/scripts/validate_spec.py skill/examples/executive-review.json out/spec-qa.json",
    "validate:all": "python3 tests/validate_examples.py",
    "plan:validate": "node skill/scripts/validate_plan.js",
    "plan:build": "node skill/scripts/compile_plan.js",
    "build:example": "node skill/scripts/build_deck.js skill/examples/executive-review.json out/executive-review.pptx",
    "qa:example": "python3 skill/scripts/quality_gate.py out/executive-review.pptx --spec skill/examples/executive-review.json --out out/quality-report.json --render-dir out/render",
    "library": "python3 skill/scripts/library_report.py",
    "test": "python3 scripts/runtime_smoke.py --tier auto",
    "test:core": "python3 scripts/runtime_smoke.py --tier core",
    "preflight": "python3 scripts/security_preflight.py",
    "package": "python3 scripts/package_runtime.py",
    "render:example": "python3 skill/scripts/render_deck.py out/executive-review.pptx out/render",
    "capabilities": "python3 core/qa/capabilities.py",
    "doctor": "python3 scripts/doctor.py",
    "bootstrap": "python3 scripts/bootstrap.py",
    "analyze:business": "node scripts/analyze.js skill/analytics/business-performance.json out/analytics/business.pptx",
    "analyze:sales": "node scripts/analyze.js skill/analytics/sales-conversion.json out/analytics/sales.pptx",
    "analyze:project": "node scripts/analyze.js skill/analytics/project-analytics.json out/analytics/project.pptx"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jszip": "3.10.2",
    "pptxgenjs": "4.0.0"
  },
  "engines": {
    "node": ">=18",
    "python": ">=3.9"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/one-drop888/goujian-strategy-slides.git"
  }
}
