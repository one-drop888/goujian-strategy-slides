  "claims": [
    {
      "id": "c-table-fact",
      "type": "FACT",
      "text": "九列渠道表覆盖四个战区：线索1,280/1,160/980/860，成交率14.2%/13.8%/11.6%/10.9%。",
      "source_ids": ["s-channel"]
    },
    {
      "id": "c-chart-recon",
      "type": "FACT",
      "text": "源图表截图的成交率与渠道表一致；原生图表按规范值重建且可编辑。",
      "source_ids": ["s-channel", "s-chart"]
    },
    {
      "id": "c-interview-hypothesis",
      "type": "HYPOTHESIS",
      "text": "访谈提示试驾后的下一步说明不足，可能影响客户比较；24位样本尚不能证明因果。",
      "source_ids": ["s-interview"],
      "depends_on": ["c-table-fact"],
      "uncertainty": "定性样本，不能代表总体比例或证明转化率差异。"
    },
    {
      "id": "c-limits",
      "type": "INTERPRETATION",
      "text": "截图文字保持嵌入不可编辑；数值通过原生表/图重建，并保留源截图供核对。",
      "source_ids": ["s-channel", "s-chart"],
      "limits": "截图与原生对象是两种证据形态，不能视为同一可编辑对象。"
    },
    {
      "id": "c-dedup",
      "type": "INTERPRETATION",
      "text": "图表截图中的成交率与渠道表重复，以渠道表为规范来源；图表仅作为派生视图。",
      "source_ids": ["s-channel", "s-chart"]
    },
    {
      "id": "c-recommendation",
      "type": "RECOMMENDATION",
      "text": "先统一指标口径，再验证跟进质量与转化结果的关系；不把访谈频次当作因果证据。",
      "source_ids": ["s-interview", "s-channel"],
      "depends_on": ["c-interview-hypothesis", "c-dedup"]
    },
    {
      "id": "c-visual-fact",
      "type": "FACT",
      "text": "封面使用项目自有的AI合成展厅示意，不是业务证据。",
      "source_ids": ["s-visual"]
    }
  ],
  "content_decisions": [
    { "source_id": "s-channel", "disposition": "retain", "rationale": "九列表格是数值的规范来源，正文与附录均保留。" },
    { "source_id": "s-chart", "disposition": "deduplicate", "dedup_target": "s-channel", "rationale": "图表截图的成交率与渠道表重复；保留截图核对，但规范数值指向渠道表。" },
    { "source_id": "s-interview", "disposition": "retain", "rationale": "访谈用于提出跟进假设，并保留样本与方法限制。" },
